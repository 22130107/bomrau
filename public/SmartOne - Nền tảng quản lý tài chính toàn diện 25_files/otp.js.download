const otp = {};
otp.arrIdError = [];
otp.timecountdown = 30;

otp.incorrectOTP = function (mes) {
    $("#mesErrOTP").html('');

    if (!$(".group-otp").hasClass("err")) {
        $(".group-otp").addClass("err");
        $("#mesErrOTP").addClass('err');
        $("#mesErrOTP").show();
    }
    $("#mesErrOTP").html(mes);
}

otp.clearFormOTP = function () {
    $(".otp-number").val("");
    $("#mesErrOTP").html('');
    $("#modalOTP .group-otp").removeClass("err");
}

otp.hideModalOTP = function () {
    $("#modalOTP").modal("hide");
}

// chức năng này làm 2 việc 
// 1 show Modal xác thực OTP
// 2 đồng thời call API send OTP
// => cần thêm tham số này vào HTML
// data-required = true nếu bắt buộc send SMS OTP
// data-required = "" không bắt buộc send SMS OTP
// và data-type = chính cmd của chức năng đó
otp.showPopupOTP = function (dom) {

    // clear OTP old 
    otp.clearFormOTP();

    let typeCMD = $(dom).attr("data-type");
    $("#btnConfirmOTP").attr("data-type", typeCMD);
    $("#btnResendOTP").attr("data-type", typeCMD);

    // 1. check xem bản thân chức năng này có bắt buộc dùng SMS OTP hay không
    let isRequired = $(dom).attr("data-required"); // bắt buộc SMS OTP

    if (isRequired) {

        $(".smsOTP").show();
        $(".smartOTP").hide();

        // call API send SMS OTP có truyền p1 = cmd (của chức năng đó)
        let p1 = typeCMD;
        otp.GetOTPCountDown(p1);
    } else {
        // 2. case chức năng này không bắt buộc dùng SMS OTP
        // => check đăng ký OTP của khách hàng là loại nào "SMS OTP || Smart OTP"   
        if (global.authenType == "M") {
            // 2.1 case KH đăng ký dùng smart OTP  
            $(".smartOTP").show();
            $(".smsOTP").hide();
        }
        else {
            // 2.2 case KH đăng ký dùng SMS OTP
            $(".smsOTP").show();
            $(".smartOTP").hide();
        }

        // call API send OTP KHÔNG bắt buộc SMS => truyền p1 = ""  
        otp.GetOTPCountDown("");
    }

    $("#modalOTP").modal("show");
}

otp.showPopupOTPForIPO = function (dom) {

    // clear OTP old 
    otp.clearFormOTP();

    let typeCMD = $(dom).attr("data-type");
    $("#btnConfirmOTP").attr("data-type", typeCMD);
    $("#btnResendOTP").attr("data-type", typeCMD);

    // 1. check xem bản thân chức năng này có bắt buộc dùng SMS OTP hay không
    let isRequired = $(dom).attr("data-required"); // bắt buộc SMS OTP

    if (isRequired) {

        $(".smsOTP").show();
        $(".smartOTP").hide();

        // call API send SMS OTP có truyền p1 = cmd (của chức năng đó) 
        otp.countDown();

    } else {
        // 2. case chức năng này không bắt buộc dùng SMS OTP
        // => check đăng ký OTP của khách hàng là loại nào "SMS OTP || Smart OTP"   
        if (global.authenType == "M") {
            // 2.1 case KH đăng ký dùng smart OTP  
            $(".smartOTP").show();
            $(".smsOTP").hide();
        }
        else {
            // 2.2 case KH đăng ký dùng SMS OTP
            $(".smsOTP").show();
            $(".smartOTP").hide();
        }

        // call API send OTP KHÔNG bắt buộc SMS => truyền p1 = ""   
        otp.countDown();
    }

    $("#modalOTP").modal("show");
}

