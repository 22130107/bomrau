        //};
        
        socket.onerror = function (event) {
            pLiveboard.Socket = socket;
            pLiveboard.Result = -1;
            console.log('[ERROR] --> Reconnecting to websocket (' + recoCount + ')....');
            // 10s
            if (recoCount <= 5) {
                setTimeout(InitWebSocket(pLiveboard), 10000);
            }
        };
    } else {
        console.log('Your browser does not support WebSockets yet.');
