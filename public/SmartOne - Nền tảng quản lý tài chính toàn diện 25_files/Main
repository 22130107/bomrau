        data: JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "ListFuncWebtrade", p1: "", p2: "", p3: "", p4: "" } }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 3000,
        success: function (vData) {
            console.log(vData);
            if (vData != null && vData.hasOwnProperty('data') && vData.data != null) {
                global.listPermission = vData.data;
            }
            if (vData.rc == -1 && (vData.rs == "FOException.InvalidSessionException" || vData.rs == "FOException.NotLoginException: Not logged in!")) {
                UserNotAuthentication();
            }
        },
        error: function (err) {

        }
    });
}
function GetTime() {
    $.ajax({
        type: "GET",
        url: "/Home/GetTime",
        cache: false,
        data: "",
        contentType: "application/json; charset=utf-8",
        dataType: "text",
        timeout: 1000,
        success: function (data) {
            if (typeof (data) !== 'undefined' && data != null && data != "") {
                document.getElementById("serverTime").innerHTML = GetNameDayOfWeak() + ", " + " " + data;
                console.log(document.getElementById("serverTime").innerHTML);
            }
        },
        error: function (err) {

        }
    });

}

function ShowServerTime(id) {
    var objTime = document.getElementById(id);

    if (objTime) {
        var vDateTime = objTime.innerHTML;
        var arrDateTime = vDateTime.split(" ");
        //console.log(arrDateTime);
        if (arrDateTime.length == 5) {
            var vDate = arrDateTime[3];
            day = vDate;
            inday = day.split("-");
            var vTime = arrDateTime[4];
            var arrTime = vTime.split(":");
            var h, m, s;
            h = parseInt(arrTime[0], 10);
            m = parseInt(arrTime[1], 10);
            s = parseInt(arrTime[2], 10);
            //Kiem tra neu giay bang 59 thi dat ve 1 va tang phut len 1
            if (s == 59) {
                s = 0;
                m = m + 1;
            } else {
                s = s + 1;
            }
            if (m == 60) { // Kiem tra neu phut bang 60 thi dat ve 0 va tang gio len 1
                m = 0;
                h = h + 1;
            }
            // Kiem tra neu gio bang 24 thi dat gio ve 0
            if (h == 24) {
                h = 0;
            }
            objTime.innerHTML = GetNameDayOfWeak() + ", " + " " + vDate + " " + GetTowDigit(h) + ":" + GetTowDigit(m) + ":" + GetTowDigit(s);
            //alert(objTime.innerHTML);
            //check hiển thị form mở tk PS
            if (!checkOnPs) {
                $.ajax({
                    type: "GET",
                    url: "/TempFile/datePs.txt?v=" + Math.random(),
                    cache: false,
                    data: JSON.stringify({}),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: false,
                    timeout: 2000,
                    success: function (vData) {
                        //console.log(vData);
                        if (vData != null && vData.hasOwnProperty('data') && vData.data != null) {
                            global.listDatePs = vData.data;
                            $.cookie("startPs", global.listDatePs['startSurvey']);
                            $.cookie("endPs", global.listDatePs['endSurvey']);
                            end = $.cookie("endPs").split("-");
                            start = $.cookie("startPs").split("-");
                            //check trong ngay su kien khao sat hay khong
                            if (parseInt(inday[0]) >= parseInt(start[0]) && parseInt(inday[0]) <= parseInt(end[0]) && parseInt(inday[1]) <= parseInt(end[1]) && parseInt(inday[1]) >= parseInt(start[1])) {
                                //trong ngay su kien thi hien thi popup
                                if ($.cookie("tainangPS") == undefined || $.cookie("tainangPS") == null || $.cookie("tainangPS") == "null") {
                                    //check stk tồn tại acc psa chua
                                    getPhoneNumber();
                                    $.cookie("tainangPS", "showed");
                                }
                            }
                        }
                        checkOnPs = true;
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
        }
    }
}

function GetNameDayOfWeak() {
    var weekday = (global.lang == 'vi-VN' ? weekday_vi : weekday_en);
    var todayDate = new Date();
    var dayIndex = todayDate.getDay();
    return weekday[dayIndex]
}

function GetTowDigit(value) {
    var vString = "";
    if (parseInt(value, 10) < 10)
        vString = "0" + value;
    else
        vString = value;
    return vString;
}

function GoogleAnalytics() {
    console.log("GoogleAnalytics");
    (function (i, s, o, g, r, a, m) {
