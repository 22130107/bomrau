function checkShowBannerCashAdvance() {
    const req = {
        group: "B",
        user: global.user,
        session: global.session,
        data: {
            type: "cursor",
            cmd: "UTTB_TK1_CURRENT_STATUS",
            p1: global.user + "1",
        }
    }

    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify(req),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 3000,
        success: function (vData) {
            if (vData && vData.data) {
                if (vData.rc === 1 && vData.data.length > 0) {
                    const resData = vData.data[0];
                    if (resData.C_STATUS === 1 && resData.C_CHANNEL === "D") {
                        initModalRegisterCashAdvance();
                    }
                }
            }
        },
        error: function (err) {
            console.log(err)
        }
    })
}

function initModalRegisterCashAdvance() {
    setTimeout(function () {
        var modalAccount = { lang: global.lang == 'vi-VN' ? popUpCashAdvLangVi : popUpCashAdvLangEn, isRegisterSuccess: false, isRegister: true };
        try {
            $.when(
                App.Utils.renderLinkTemplate({ Module: 'CashAdv', Name: 'RegisterCashAdvance', Selector: '#divModalRegisterCashAdv', Modal: modalAccount })
            ).done(function () {
                $('#modal-register-cash-advance').modal('show');
                const getListUserShowBanner = localStorage.getItem('listUserShowBannerCashAdv') ? JSON.parse(localStorage.getItem('listUserShowBannerCashAdv')) : [];
                getListUserShowBanner.push(global.user);
                localStorage.setItem('listUserShowBannerCashAdv', JSON.stringify(getListUserShowBanner));
            })
        } catch (e) {
            console.log(e);
        }
    }, 1000)
}

// 3.26. API kiểm tra trạng thái tài khoản liên kết
function GetInfContractTwoMain(langAPI, success) {

    var vRandom = replace(Math.random() + "", ".", "");
    var date = getdateyyyymmddhhmmss();
    var browser = getBrowser();

    var langAPI = (global.lang == "vi-VN") ? "VI" : "EN";
    var url = `${global.hostmm}/api/account-link/check-account-status`;
    var cmd = "API.SM_ACCOUNT_LINK_CHECK";
    var data = JSON.stringify({
        "lang": langAPI,
        "channel": "I"
    });

    return $.ajax({
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 1000,
        cache: false,
        method: "POST",
        url: url,
        cmd: cmd,
        headers: {
            "X-AUTH-USER": global.user,
            "X-REQUEST-GROUP": "MM",
            "X-AUTH-SESSION": global.session,
            "X-REQUEST-ID": vRandom + "_MM_" + browser + "_" + date,
        },
        data: data,
        success: function (vData) {
            if (vData && vData.data && vData.data.length > 0 && vData.data[0].C_ACCOUNT) {
                success(vData.data[0].C_ACCOUNT);
            } else if (vData && vData.rc == -1) {
                console.log('Error' + vData.rs);
            }
        },
        error: function (err) {
            console.log('Error GetInfContract!' + err.responseJSON.message);
        }
    }); 
}

function getdateyyyymmddhhmmss() {
    var currentDate = new Date();
    var currentYear = (new Date).getFullYear();
    var y, m, d, h, mi, d;
    var date = "";
    y = currentYear;
    m = currentDate.getMonth();
    m = m + 1;
    if (m.length == 1) {
        m = "0" + m;
    }
    d = currentDate.getDate();
    h = currentDate.getHours();
    mi = currentDate.getMinutes();
    s = currentDate.getSeconds();
    date = y + "" + m + "" + d + "" + h + "" + mi + "" + s + "";
    return date;
}

function getBrowser() {
    var browser = navigator.userAgent;
    if (browser.indexOf('MSIE') > 0) {
        browser = browser.substr(a.indexOf('MSIE'), a.length - a.indexOf('MSIE'));
    }
    else if (browser.indexOf('Firefox') > 0) {
        browser = browser.substr(browser.indexOf('Firefox'), browser.length - browser.indexOf('Firefox'));
    }
    else if (browser.indexOf('coc_coc') > 0) {
        browser = browser.substr(browser.indexOf('coc_coc'), browser.length - browser.indexOf('coc_coc'));
    }
    else if (browser.indexOf('Chrome') > 0) {
        browser = browser.substr(browser.indexOf('Chrome'), browser.length - browser.indexOf('Chrome'));
    }
    else if (browser.indexOf('Safari') > 0) {
        browser = browser.substr(browser.indexOf('Safari'), browser.length - browser.indexOf('Safari'));
    }
    else if (browser.indexOf('Opera') > 0) {
        browser = browser.substr(browser.indexOf('Opera'), browser.length - browser.indexOf('Opera'));
    }
    else {
        browser = "UNKNOWN";
    }
    return browser;
}

// Chặn GD theo công văn 4501
function checkChanCCCD() {

    // get cookie gắn với mỗi tài khoản
    const keyname = `CacheBlockTransaction${global.user}`;
    const CacheBlockTransaction = $.cookie(keyname);

    if (CacheBlockTransaction) {
        console.log(keyname);
        return;
    }
 
    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "GetAccountInfo", p1: global.user + "1", p2: "", p3: "", p4: "", p5: "", p6: "", p7: "", p8: "" } }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 1000,
        success: function (vData) {
              
            // mỗi ngày show thông báo 1 lần => check đã show thông báo chưa
            if (!CacheBlockTransaction) {
                 
                // Các giá trị trả về như sau: 0: Dữ liệu sạch; 1: Chờ sạch; 2: Không sạch.
                if (vData && vData.rc == 1 && vData.data && Array.isArray(vData.data) && vData.data[0] && vData.data[0].C_IS_CARD_CLEAR == 2) {
                    $("#modalBlockTransaction").modal("show");

                    // không sạch => set lại cờ để không load lại 2 lần trong ngày
                    var date = new Date();
                    var end = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 23, 59, 59);

                    $.cookie(keyname, "true", { path: "/", expires: end });
                }
            } 
        },
        error: function (err) {

        }
    });
}

