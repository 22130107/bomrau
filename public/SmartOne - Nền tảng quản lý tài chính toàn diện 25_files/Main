function checkShowBHBAProduct() {
    // get cookie gắn với mỗi tài khoản
    const keyname = `CacheShowBHBAProduct${global.user}`;
    const CacheShowBHBAProduct = $.cookie(keyname);

    if (CacheShowBHBAProduct) {
        console.log(keyname);
        return;
    }


 
    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "INSR_FEE.GET_POPUP_SHOW"} }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 1000,
        success: function (vData) {
            // chỉ show thông báo 1 lần mỗi tài khoản => check đã show thông báo chưa
            if (!CacheShowBHBAProduct) {
                 
                // Các giá trị trả về như sau: 0: không hiển thị; 1: Hiển thị popup.
                if (vData && vData.rc == 1 && vData.data && Array.isArray(vData.data) && vData.data[0] && vData.data[0].C_SHOW_POPUP == 1) {
                    $("#modalBHBAProduct").modal("show");

                    //set cookie vô thời hạn
                    $.cookie(keyname, "true", { path: "/", expires: 365 });
                }
            } 
        },
        error: function (err) {
            console.log(err);
        }
    });
}

