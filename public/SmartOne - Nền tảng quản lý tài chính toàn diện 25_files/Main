function ListPortfolio() {
    console.log('==== AccountPorfolio =====');
    var requestObj = {
        group: "B",
        user: global.user,
        session: global.session,
        data: {
            type: "cursor2",
            cmd: "AccountPorfolio",
            p1: "",
            p2: "null",
            p3: "null",
            p4: "null"
        }
    };
    console.log(JSON.stringify(requestObj));
    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify(requestObj),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 3000,
        success: function (vData) {
            console.log(vData);

            if (vData != null && vData.hasOwnProperty('data') && vData.data != null) {
                global.listPortfolio = vData.data[0].data1;
                for (var i = 0; i < global.listPortfolio.length; i++) {
                    if (global.listPortfolio[i].C_DEFAULT == "1") {
                        $.cookie("listStockId", global.listPortfolio[i].PK_ACCOUNT_PORFOLIO, { expires: 365 });
                        $.cookie("listStockName", global.listPortfolio[i].C_PORFOLIO_NAME, { expires: 365 });
                        $.cookie("listStock", global.listPortfolio[i].C_LIST_SHARE_CODE, { expires: 365 });
                    }
                }
                if (vData != null && vData.data[0] != null && vData.data[0].data2 != null) {
                    for (var i = 0; i < vData.data[0].data2.length; i++) {
                        switch (vData.data[0].data2[i].C_PARAMETER_CODE) {
                            case 'HIDE_CONFIRM_ORDER':
                                global.confirmOrder = vData.data[0].data2[i].C_PARAMETER_VALUE;
                                break;
                            default:
                                break;
                        }
                    }
                }

                //console.log("global.listPortfolio", global.listPortfolio);
            }
            if (vData.rs == "FOException.InvalidSessionException") {
                UserNotAuthentication();
            }
        },
        error: function (err) {

        }
    });

}
function ListAccount() {
    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "ListAccount", p1: "", p2: "null", p3: "null", p4: "null" } }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 3000,
        success: function (vData) {
            console.log(vData);
            if (vData != null && vData.hasOwnProperty('data') && vData.data != null) {
                global.listAccount = vData.data;
                console.log(vData);
            }
            if (vData.rc == -1 && (vData.rs == "FOException.InvalidSessionException" || vData.rs == "FOException.NotLoginException: Not logged in!")) {
                UserNotAuthentication();
            }
        },
        error: function (err) {
            console.log(err);
        }
    });

}

