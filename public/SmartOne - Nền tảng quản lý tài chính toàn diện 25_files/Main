function InitWebSocket(pLiveboard) {
    var recoCount = 0;
    if (window.WebSocket || window.MozWebSocket) {
        var socket = new WebSocket(pLiveboard.Link);
        //console.log(socket);
        socket.onopen = function (event) {
            recoCount = 0;            
            // Register all 
            //send('REGD|ALL|0');
            //regisRealtime();
            pLiveboard.Socket = socket;
            pLiveboard.Result = 1;
            console.log('[OPEN] --> connected to websocket ' + pLiveboard.Link);
        };
        socket.onclose = function (event) {
            pLiveboard.Socket = socket;
            pLiveboard.Result = -1;
            console.log('[CLOSE] --> Reconnecting to websocket (' + recoCount + ')....');
            // 10s
            setTimeout(InitWebSocket(pLiveboard), 10000);
        };

