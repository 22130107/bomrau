function btnSubmitClick() {
    if ($("#txtPhone").val() == "") {
        jAlert("Hãy điền số điện thoại");
        return;
    }
    if ($("#txtName").val() == "") {
        jAlert("Hãy điền họ và tên");
        return;
    }
    if ($("#txtUsername").val() == "") {
        jAlert("Hãy điền tên đăng nhập");
        return;
    }
    if ($("#txtPass").val() == "") {
        jAlert("Hãy điền mật khẩu");
        return;
    }
    if ($("#txtConfirmPass").val() == "") {
        jAlert("Hãy điền xác nhận mật khẩu");
        return;
    }
    if ($("#txtConfirmPass").val() != $("#txtPass").val()) {
        jAlert("Mật khẩu và Xác nhận mật khẩu phải giống nhau");
        return;
    }
    if ($("#txtOTP").val() == "") {
        jAlert("Hãy điền OTP");
        return;
    }
    $.post(global.HostPSA + "/handler/OpenAccount.aspx", {
        p1: $("#txtUsername").val(), p2: $("#txtPhone").val(), p3: CryptoJS.MD5($("#txtPass").val()).toString().toUpperCase(), p4: $("#txtName").val() == '' ? $("#txtUsername").val() : $("#txtName").val(), p5: $("#txtOTP").val()
    }, function (zdata) {
        if (zdata.rc == 1) {
            jAlert('Tài khoản chứng khoán ảo của quý khách đã được mở thành công. Quý khách vui lòng tải ứng dụng SmartPro trên mobile để sử dụng.');
            $('#divAdvertPS').modal('hide');
        } else {
            jAlert(zdata.data.msg);
        }
    });
}
function getPhoneNumber() {
    //lay sdt tai khoan
    console.log(JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "GetAccountInfo", p1: global.user + "1", p2: "", p3: "", p4: "", p5: "", p6: "", p7: "", p8: "" } }));
    $.ajax({
        type: "POST",
        url: "/Api/Proxy",
        cache: false,
        data: JSON.stringify({ group: "B", user: global.user, session: global.session, data: { type: "cursor", cmd: "GetAccountInfo", p1: global.user + "1", p2: "", p3: "", p4: "", p5: "", p6: "", p7: "", p8: "" } }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        timeout: 1000,
        success: function (vData) {
            console.log(vData);
            //$.observable(modal.accountInfo).refresh(vData.data);
            if (vData.data.length > 0) {
                checkExistAcc(vData.data[0].C_CUST_MOBILE)
                phone = vData.data[0].C_CUST_MOBILE;
            }
        },
        error: function (err) {

        }
    });
}
function checkExistAcc(PhoneNo) {
    if (PhoneNo!="") {
        $.post(global.HostPSA + "/handler/CheckPhoneTKOnline.aspx", {
            p1: PhoneNo
        }, function (zdata) {
            if (zdata.rc == 1) {
                showPs(PhoneNo);
            } else {
                //jAlert(zdata.data.msg);
            }
        });
    }
}
