$(function () {
    const client = new ClientJS();
    const timeToLive = 60000;
    let getGSSCInterval;
    let textOndevice;
    const listExcludeFP = global.listExcludeFP ? global.listExcludeFP.split(",") : [];
    let sourceGssc = "";
    let xGSSC = "";
    let user = "";
    let countTimeGetGsscFromStore = 0;

    if (client.isMobileWindows()) {
        textOndevice = "Mobile Windows";
    }

    if (client.isMobileAndroid()) {
        textOndevice = "Mobile Android";
    }

    if (client.isWindows()) {
        textOndevice = "Windows";
    }

    if (client.isMobileIOS() && client.isIphone()) {
        textOndevice = "Iphone Mobile IOS";
    }

    if (client.isMobileIOS() && client.isIpad()) {
        textOndevice = "Ipad Mobile IOS";
    }

    if (client.isMac()) {
        textOndevice = "Mac";
    }
    
    const getGSSCFromStore = function () {
        countTimeGetGsscFromStore++;
        xGSSC = global.getGSSCFromCookies();

        if (xGSSC) {
            sourceGssc = 1;
        } else {
            xGSSC = global.getGSSCFromLocalStorage();
            if (xGSSC) {
                sourceGssc = 2;
            }
        }

        $('#txtGSSC').val(xGSSC);

        if (!xGSSC && countTimeGetGsscFromStore < 3) {
            getGSSCFromStore();
        }
    };

    const getGSSC = function () {
        user = localStorage.getItem("cusId") ? localStorage.getItem("cusId") : "";
        $.when(getGSSCFromStore()).done(function () {
            countTimeGetGsscFromStore = 0;

            const date = new Date();
            date.setTime(date.getTime() + 365 * 10 * 24 * 3600 * 1000);

            let Fingerprint;
            const fp = FingerprintJS.load();

            fp.then(rs => rs.get()).then(result => {
                const newComponents = result.components;
                try {
                    listExcludeFP.forEach((item) => {
                        delete newComponents[item];
                    });
                } catch (e) {
                    console.error(e);
                }

                Fingerprint = FingerprintJS.hashComponents(newComponents);

                const req = {
                    deviceFP: Fingerprint,
                    deviceInfo: {
                        type: "SmartOne Web",
                        appVersion: global.version,
                        os: client.getOS(),
                        model: navigator.userAgent,
                        deviceVersion: client.getBrowser() + " - " + client.getBrowserMajorVersion() + " - " + textOndevice,
                        geoLocation: xGSSC,
                        timezone: "GMT" + client.getTimeZone()
                    },
                    components: btoa(JSON.stringify(newComponents))
                }

                try {
                    $.ajax({
                        type: "POST",
                        url: global.idcSystem + "/proxy/idcService/gssc",
                        cache: false,
                        headers: {
                            "x-gssc": xGSSC,
                            "x-source-gssc": sourceGssc,
                            "x-user-gssc": user
                        },
                        data: JSON.stringify(req),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (res) {
                            if (res && res.gssc) {
                                $.cookie("gsscvps", res.gssc, { path: "/", expires: date });
                                localStorage.setItem("gsscvps", res.gssc);
                                $('#txtGSSC').val(res.gssc);

                                if (res.timeToLive !== timeToLive) {
                                    clearInterval(getGSSCInterval);
                                    renewGSSC(res.timeToLive);
                                }
                            }
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    })
                } catch (e) {
                    clearInterval(getGSSCInterval);
                    renewGSSC(timeToLive);
                }
            })
        })
    }

    const renewGSSC = function (time) {
        getGSSCInterval = setInterval(() => {
            getGSSC()
        }, time)
    }

    getGSSC();
})